# Sogo runs fully in demo mode with no variables set.
# Fill these in to enable the real OAuth redirect flows.

# Google OAuth 2.0 Web client ID (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple Services ID (https://developer.apple.com/account/resources/identifiers)
VITE_APPLE_CLIENT_ID=

# Backend endpoint that exchanges the OAuth authorization code for a session.
# Required for OAuth to complete; without it the callback screen explains what is missing.
VITE_AUTH_API_URL=

# Public URL used in share links (defaults to the current origin).
VITE_PUBLIC_URL=
